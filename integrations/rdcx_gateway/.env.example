# Non-secret deployment template
RDCX_GATEWAY_AUTH_ENABLED=true
RDCX_GATEWAY_AUTH_SINGLE_CLIENT=true
RDCX_GATEWAY_AUTH_REQUIRE_APPROVAL=true
RDCX_GATEWAY_HOST=127.0.0.1
RDCX_GATEWAY_PORT=8789
RDCX_GATEWAY_REGISTRY=/etc/rdcx-mcp/registry.json
RDCX_GATEWAY_SESSIONS=/var/lib/rdcx-mcp/sessions.json
RDCX_GATEWAY_CLIENTS=/var/lib/rdcx-mcp/client-tenants.json
RDCX_GATEWAY_AUDIT=/var/log/rdcx-mcp/audit.jsonl
RDCX_GATEWAY_SPOOL=/var/lib/rdcx-spool
RDCX_GATEWAY_ISSUER=https://example.invalid
RDCX_GATEWAY_RESOURCE_URL=https://example.invalid/mcp
